# =============================================================================
#  NAS Stack — Environment Configuration
#  Kopiere diese Datei nach .env und passe die Werte an:
#    cp .env.example .env && chmod 600 .env && nano .env
# =============================================================================

# --- Allgemein ---
TZ=Europe/Berlin
DATA_ROOT=/mnt/data

# --- Cloudflare Tunnel ---
# Token aus: Zero Trust → Networks → Tunnels → <tunnel> → Copy token
TUNNEL_TOKEN=PASTE_YOUR_TUNNEL_TOKEN_HERE


# --- Vaultwarden ---
# Admin-Token generieren: openssl rand -hex 32
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL
VAULTWARDEN_SIGNUPS=false

# --- Watchtower Benachrichtigungen (optional) ---
# Format: https://containrrr.dev/shoutrrr/latest/services/overview/
# Beispiel Telegram: telegram://TOKEN@telegram?chats=CHAT_ID
# Beispiel Discord:  discord://TOKEN@WEBHOOK_ID
WATCHTOWER_NOTIFY_URL=

# --- Image-Versionen (Pinning) ---
CLOUDFLARED_VERSION=2026.9.3
FILEBROWSER_VERSION=v2.31.2
NEXTCLOUD_AIO_VERSION=latest
VAULTWARDEN_VERSION=1.32.7
JELLYFIN_VERSION=10.10.6
HOMEPAGE_VERSION=v1.2.0
UPTIME_KUMA_VERSION=1.23.15
WATCHTOWER_VERSION=1.7.1
